{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/MDylan/laraupdater"
        }
    ],
    "require": {
        "php": "^8.0",
        "astrotomic/laravel-translatable": "^11.9",
        "dialect/laravel-gdpr-compliance": "1.4.7",
        "doctrine/dbal": "^3.1",
        "eusonlito/laravel-packer": "^2.2",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "joedixon/laravel-translation": "^1.1",
        "laravel/fortify": "~1.11.2",
        "laravel/framework": "^8.12",
        "laravel/tinker": "^2.5",
        "laravelcollective/html": "^6.2",
        "laravolt/avatar": "^4.1",
        "livewire/livewire": "^2.10.4",
        "mdylan/laraupdater": "^2.0",
        "petercoles/multilingual-country-list": "^1.2",
        "protonemedia/laravel-verify-new-email": "^1.6",
        "spatie/calendar-links": "^1.6",
        "spatie/laravel-activitylog": "^4.0.0",
        "spatie/laravel-cookie-consent": "^3.1",
        "spatie/laravel-failed-job-monitor": "^4.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "php81 artisan optimize:clear --quiet && php81 vendor/phpunit/phpunit/phpunit"
    },
    "scripts-descriptions": {
        "test": "Clears the build caches, then runs the PHPUnit suite against the kozter_testing database. Use this, never `artisan test` - that one boots the framework first, so .env wins over phpunit.xml and RefreshDatabase would wipe the application database."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.0.9"
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-m5cs-t1y6-qpcs": {
                        "reason": "Temporary signed URL path confusion. Fixed in 12.61.1 only - there is no Laravel 8 backport and Laravel 8 is EOL. Unblocks resolution only; composer audit still reports it. See upgrade-roadmap.md, v1-patch H.",
                        "on-audit": false
                    },
                    "PKSA-3r5d-mb8f-1qw9": {
                        "reason": "CRLF injection in the default email validation rule. Fixed in 12.60.0 only - no Laravel 8 backport. Unblocks resolution only; composer audit still reports it. See upgrade-roadmap.md, v1-patch H.",
                        "on-audit": false
                    },
                    "PKSA-8qx3-n5y5-vvnd": {
                        "reason": "CVE-2025-27515 file validation bypass. Fixed in 10.48.29 only - no Laravel 8 backport. Unblocks resolution only; composer audit still reports it. See upgrade-roadmap.md, v1-patch H.",
                        "on-audit": false
                    }
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
