{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/MDylan/laraupdater"
        }
    ],
    "require": {
        "php": "^8.3",
        "astrotomic/laravel-translatable": "^11.9",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^3.0",
        "mdylan/laraupdater": "^2.0",
        "petercoles/multilingual-country-list": "^1.2",
        "spatie/calendar-links": "^1.6",
        "spatie/laravel-activitylog": "^4.0.0",
        "spatie/laravel-cookie-consent": "^3.1",
        "spatie/laravel-failed-job-monitor": "^4.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "php artisan optimize:clear --quiet && php vendor/phpunit/phpunit/phpunit"
    },
    "scripts-descriptions": {
        "test": "Clears the build caches, then runs the PHPUnit suite against the kozter_testing database. Use this, never `artisan test` - that one boots the framework first, so .env wins over phpunit.xml and RefreshDatabase would wipe the application database."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
