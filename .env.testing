APP_NAME="Public Witnessing"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL="http://kozter.test"
APP_LANG="hu"
APP_FALLBACK_LOCALE=en
USE_HTTPS=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="kozter_testing"
DB_USERNAME="root"
DB_PASSWORD=""

BROADCAST_DRIVER=log
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120
FILESYSTEM_DRIVER=local

MAIL_MAILER=array
MAIL_FROM_ADDRESS="tests@kozter.test"
MAIL_FROM_NAME="${APP_NAME}"

USE_RECAPTCHA=false
GDPR_ENABLED=false
TIMEZONE="Europe/Budapest"
