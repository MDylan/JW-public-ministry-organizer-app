/node_modules
/public/hot
/public/storage
# Leftovers of the removed avatar files (TODO 39.1). Nothing writes here any
# more - the message board computes an SVG data URI per author instead - but
# every install and every dev machine still carries the PNGs the old mechanism
# generated, and dropping the pattern would sweep them into a commit. It stays
# for the same reason the packer patterns below do.
/public/avatars/*
# Leftovers of the removed packer (eusonlito/laravel-packer). It wrote its
# output as {filemtime}-cache_*.ext next to the source asset, plus a mirror of
# the whole asset tree under public/cache. Nothing references them any more,
# the names differ per install, and release/upgrade.php deletes them on the
# target host - so they must never enter a commit. The patterns match the ones
# the upgrade hook removes.
/public/cache/
/public/dist/**/*-cache_*
/public/plugins/**/*-cache_*
/storage/*.key
.env
.env.backup
.phpunit.result.cache
/.phpunit.cache
docker-compose.override.yml
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/storage/installed
/.vscode
/tmp/*
# vendor/ is COMMITTED on purpose. There is no composer install on the target
# host: the release archive carries the tree itself, and release/build-update.php
# builds that archive from a GIT DIFF, so an untracked package cannot ship.
#
# This line used to read "/vendor", and the tree was force-added past it. That
# silently dropped every package Composer added afterwards, because `git add -A`
# and `git add -u` both skip ignored paths - 1037 files by the time TODO 35.1
# measured it. Ignoring nothing here is what makes the ordinary commit flow, the
# builder's dirty-tree check and `git status --porcelain vendor/` all work.
#
# The IDE cache is the one thing under vendor/ that Composer did not put there.
/vendor/_laravel_ide/
# Update archives built by release/build-update.php
/release/dist
