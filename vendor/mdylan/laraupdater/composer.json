{
    "name": "mdylan/laraupdater",
    "description": "LaraUpdater allows your Laravel Application to auto-update itself. Maintained fork of pcinaglia/laraupdater.",
    "keywords": [
        "self-updater",
        "update-checker",
        "update-installer",
        "laravel",
        "backup-restore"
    ],
    "homepage": "https://github.com/MDylan/laraupdater",
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.12|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Pietro Cinaglia",
            "homepage": "http://linkedin.com/in/pietrocinaglia",
            "role": "Original author"
        },
        {
            "name": "David Molnar",
            "homepage": "https://github.com/MDylan",
            "role": "Fork maintainer"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "MDylan\\LaraUpdater\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MDylan\\LaraUpdater\\LaraUpdaterServiceProvider"
            ]
        }
    }
}
