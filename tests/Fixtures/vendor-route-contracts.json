   "App\\Http\\Middleware\\EnsureUpdateWithinBranch",
   "auth",
   "can:is-admin",
   "web"
  ]
 },
 "laraupdater.currentVersion": {
  "methods": [
   "GET",
   "HEAD"
  ],
  "middleware": [
   "App\\Http\\Middleware\\EnsureUpdateWithinBranch",
   "auth",
   "can:is-admin",
   "web"
  ]
 },
 "laraupdater.update": {
  "methods": [
   "GET",
   "HEAD"
  ],
  "middleware": [
   "App\\Http\\Middleware\\EnsureUpdateWithinBranch",
   "auth",
   "can:is-admin",
   "web"
  ]
 },
 "livewire.message": {
  "methods": [
   "POST"
  ],
  "middleware": [
   "web"
  ]
 },
